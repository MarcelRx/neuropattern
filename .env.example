# =============================================================================
# NeuroPattern LifeTracker — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your real API keys.
# setup.sh auto-generates SECRET_KEY and JWT_SECRET_KEY for you.
# =============================================================================

# ── Environment ───────────────────────────────────────────────────────────────
ENVIRONMENT=development

# ── Application (Configurable via environment variables) ───────────────────────
# These values can be overridden to customize your deployment
APP_NAME=NeuroPattern LifeTracker
VERSION=2.5.0
HOST=0.0.0.0
PORT=8000

# ── Debugging & Logging (Docker Compose Only) ───────────────────────────────────
# NOTE: These variables are used by docker-compose.yml but are not currently
# read by the backend application configuration. They are documented here for
# Docker Compose deployments only.
# DEBUG: Enable debug mode (1 for enabled, 0 for disabled)
# LOG_LEVEL: Logging level (DEBUG, INFO, WARNING, ERROR, CRITICAL)
DEBUG=1
LOG_LEVEL=INFO

# ── MongoDB ────────────────────────────────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/neuropattern
# Or use individual components:
# DB_HOST=localhost
# DB_PORT=27017
# DB_NAME=neuropattern
# DB_USER=
# DB_PASSWORD=

# Docker Compose MongoDB Configuration (for local development)
# MONGO_INITDB_ROOT_USERNAME=root
# MONGO_INITDB_ROOT_PASSWORD=changeme
# MONGO_APP_USER=neuropattern_app
# MONGO_APP_PASSWORD=app_changeme_in_production

# ── Security (AUTO-GENERATED by setup.sh — do not edit manually) ──────────────
SECRET_KEY=your_secret_key_here
JWT_SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── AI Services (Required) ───────────────────────────────────────────────────
GROQ_API_KEY=gsk_your_key_here
GROQ_MODEL=llama-3.3-70b-specdec
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=BpjGufoPiobT79j2vtj4
ELEVENLABS_MODEL_ID=eleven_multilingual_v2

# ── Email (Optional — needed for password reset) ───────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=noreply@neuropattern.app

# ── URLs ───────────────────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ── Frontend (Vite requires VITE_ prefix) ────────────────────────────────────
VITE_API_URL=http://localhost:8000/api/v1
VITE_FRONTEND_URL=http://localhost:3000

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list. Add production domains when deploying.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# For detailed setup instructions, debug commands, and Docker troubleshooting,
# see docs/SETUP_GUIDE.md
